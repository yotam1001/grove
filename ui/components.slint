// Shared controls. Every interactive element has hover, pressed and focus
// states; standard widgets underneath keep keyboard and accessibility behavior.
import { Button, ListView, Slider } from "std-widgets.slint";
import { GroveTheme, GroveMotion } from "theme.slint";
import { GroveFeatureTrack, GrovePlaylist } from "model.slint";

export component GroveSwitch inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback toggled;
    height: 32px;
    horizontal-stretch: 0;
    min-width: switch-layout.min-width;
    accessible-role: switch;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }
    forward-focus: keyboard;
    switch-layout := HorizontalLayout {
        spacing: 12px;
        alignment: start;
        Rectangle {
            width: 40px; height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 11px;
            background: root.checked ? (touch.has-hover ? GroveTheme.accent-hover : GroveTheme.accent) : touch.has-hover ? GroveTheme.hover : GroveTheme.surface;
            border-width: keyboard.has-focus ? 2px : 1px;
            border-color: keyboard.has-focus ? GroveTheme.focus : root.checked ? GroveTheme.accent : GroveTheme.border;
            animate background { duration: GroveMotion.fast; easing: ease-out; }
            Rectangle {
                x: root.checked ? 21px : 3px; y: 3px;
                width: 16px; height: 16px; border-radius: 8px;
                background: root.checked ? GroveTheme.on-accent : GroveTheme.secondary;
                animate x { duration: GroveMotion.base; easing: ease-out; }
            }
        }
        Text { text: root.text; color: GroveTheme.text; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
}

// One stroked 24×24 icon. Filled kinds are listed in `fill`.
export component Mark inherits Path {
    in property <string> kind;
    in property <color> ink: GroveTheme.accent;
    width: 22px; height: 22px;
    viewbox-width: 24; viewbox-height: 24;
    fill: root.kind == "play" || root.kind == "pause" || root.kind == "next" || root.kind == "previous" || root.kind == "leaf" || root.kind == "heart-filled" ? root.ink : transparent;
    stroke: root.ink; stroke-width: 1.7px;
    commands: root.kind == "leaf" ? "M 4 21 C 6 14 9 9 18 4 M 6 16 C 0 8 12 2 21 2 C 22 12 17 21 6 16 Z"
        : root.kind == "play" ? "M 7 4 L 20 12 L 7 20 Z"
        : root.kind == "pause" ? "M 6 5 L 10 5 L 10 19 L 6 19 Z M 14 5 L 18 5 L 18 19 L 14 19 Z"
        : root.kind == "next" ? "M 5 5 L 15 12 L 5 19 Z M 18 5 L 18 19"
        : root.kind == "previous" ? "M 19 5 L 9 12 L 19 19 Z M 6 5 L 6 19"
        : root.kind == "queue" ? "M 8 5 L 22 5 M 8 12 L 22 12 M 8 19 L 22 19 M 2 5 L 4 5 M 2 12 L 4 12 M 2 19 L 4 19"
        : root.kind == "queue-play" ? "M 3 6 L 20 6 M 3 12 L 13 12 M 3 18 L 13 18 M 17 12 L 22 15 L 17 18 Z"
        : root.kind == "library" ? "M 4 4 L 4 20 M 9 4 L 9 20 M 14 5 L 19 4 L 22 19 L 17 20 Z"
        : root.kind == "people" ? "M 9 3 A 3 3 0 1 0 9 9 A 3 3 0 1 0 9 3 Z M 3 21 L 3 18 C 3 11 15 11 15 18 L 15 21 M 17 4 C 22 4 22 10 17 10 M 18 13 C 22 13 23 17 22 21"
        : root.kind == "listen" ? "M 3 9 L 3 15 M 7 5 L 7 19 M 12 2 L 12 22 M 17 6 L 17 18 M 22 10 L 22 14"
        : root.kind == "link" ? "M 9 15 L 15 9 M 8 17 L 6 19 C 2 22 -1 17 2 14 L 7 9 C 9 7 12 7 14 9 M 10 15 C 12 17 15 17 17 15 L 22 10 C 25 7 21 2 18 5 L 16 7"
        : root.kind == "home" ? "M 3 10 L 12 3 L 21 10 M 5 9 L 5 21 L 10 21 L 10 14 L 14 14 L 14 21 L 19 21 L 19 9"
        : root.kind == "search" ? "M 17 10 A 7 7 0 1 1 3 10 A 7 7 0 1 1 17 10 M 15 15 L 22 22"
        : root.kind == "settings" ? "M 3 6 L 21 6 M 3 12 L 21 12 M 3 18 L 21 18 M 8 3 L 8 9 M 16 9 L 16 15 M 10 15 L 10 21"
        : root.kind == "repeat" ? "M 17 3 L 21 7 L 17 11 M 21 7 L 7 7 C 4 7 3 9 3 12 M 7 21 L 3 17 L 7 13 M 3 17 L 17 17 C 20 17 21 15 21 12"
        : root.kind == "shuffle" ? "M 3 6 L 7 6 C 11 6 13 18 17 18 L 21 18 M 17 14 L 21 18 L 17 22 M 3 18 L 7 18 C 11 18 13 6 17 6 L 21 6 M 17 2 L 21 6 L 17 10"
        : root.kind == "heart" || root.kind == "heart-filled" ? "M 20.8 4.6 A 5.5 5.5 0 0 0 13.1 4.6 L 12 5.7 L 10.9 4.6 A 5.5 5.5 0 0 0 3.2 12.4 L 12 21.2 L 20.8 12.4 A 5.5 5.5 0 0 0 20.8 4.6 Z"
        : root.kind == "hide" ? "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M 5.6 5.6 L 18.4 18.4"
        : root.kind == "lyrics" ? "M 9 5 A 3 3 0 0 1 15 5 L 15 11 A 3 3 0 0 1 9 11 Z M 5 10 L 5 11 A 7 7 0 0 0 19 11 L 19 10 M 12 18 L 12 22 M 8 22 L 16 22"
        : root.kind == "mini" ? "M 3 4 L 21 4 L 21 20 L 3 20 Z M 12 12 L 19 12 L 19 18 L 12 18 Z"
        : root.kind == "volume" ? "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 8 C 19 10 19 14 16 16 M 19 5 C 24 9 24 15 19 19"
        : root.kind == "volume-off" ? "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 9 L 22 15 M 22 9 L 16 15"
        : root.kind == "back" ? "M 15 5 L 8 12 L 15 19"
        : root.kind == "forward" ? "M 9 5 L 16 12 L 9 19"
        : root.kind == "close" ? "M 6 6 L 18 18 M 18 6 L 6 18"
        : root.kind == "plus" ? "M 12 5 L 12 19 M 5 12 L 19 12"
        : root.kind == "grip" ? "M 6 8 L 18 8 M 6 12 L 18 12 M 6 16 L 18 16"
        : root.kind == "up" ? "M 12 19 L 12 5 M 6 11 L 12 5 L 18 11"
        : root.kind == "down" ? "M 12 5 L 12 19 M 6 13 L 12 19 L 18 13"
        : root.kind == "expand" ? "M 5 15 L 12 8 L 19 15"
        : root.kind == "collapse" ? "M 5 9 L 12 16 L 19 9"
        : root.kind == "refresh" ? "M 20 7 L 20 3 M 20 7 L 16 7 M 20 7 A 9 9 0 1 0 21 14"
        : root.kind == "user" ? "M 16 8 A 4 4 0 1 1 8 8 A 4 4 0 1 1 16 8 M 4 21 C 4 15 20 15 20 21"
        : root.kind == "palette" ? "M 12 3 A 9 9 0 1 0 12 21 C 14 21 14 18 12.5 17 C 11 16 12 14 14 14 L 17 14 C 19.5 14 21 12.5 21 11 C 21 6.5 17 3 12 3 Z M 8 10 L 8 10.5 M 12 7 L 12 7.5 M 16 10 L 16 10.5"
        : root.kind == "check" ? "M 5 12 L 10 17 L 19 7"
        : root.kind == "more" ? "M 5 11 A 1 1 0 1 0 5 13 A 1 1 0 1 0 5 11 Z M 12 11 A 1 1 0 1 0 12 13 A 1 1 0 1 0 12 11 Z M 19 11 A 1 1 0 1 0 19 13 A 1 1 0 1 0 19 11 Z"
        : "M 9 18 L 9 5 L 21 2 L 21 15 M 9 5 L 21 2 M 9 18 C 9 23 1 24 1 20 C 1 17 9 15 9 18 M 21 15 C 21 20 13 21 13 17 C 13 14 21 12 21 15";
}

export component GroveButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> label;
    in property <bool> active-icon: false;
    in property <bool> accent: false;
    in property <bool> selected: false;
    in property <bool> flat: false;
    in property <bool> round: false;
    in property <bool> enabled: true;
    in property <bool> navigation: false;
    // Icon size; 0px picks the default for the button kind.
    in property <length> icon-size: 0px;
    out property <bool> hovered: touch.has-hover && root.enabled;
    private property <bool> down: control.pressed && root.enabled;
    private property <color> ink: !root.enabled ? GroveTheme.disabled : root.active-icon ? GroveTheme.accent : root.accent ? GroveTheme.on-accent : root.navigation && !root.selected ? (root.hovered ? GroveTheme.text : GroveTheme.secondary) : GroveTheme.text;
    callback clicked;
    min-width: 40px; height: 40px;
    border-radius: root.round ? self.height / 2 : GroveTheme.radius-sm + 2px;
    background: !root.enabled ? (root.flat ? transparent : root.accent ? GroveTheme.pressed : GroveTheme.surface)
        : root.down ? (root.accent ? GroveTheme.accent-pressed : GroveTheme.pressed)
        : root.accent ? (root.hovered ? GroveTheme.accent-hover : GroveTheme.accent)
        : root.selected ? (root.navigation ? GroveTheme.selected : GroveTheme.accent-soft)
        : root.hovered ? GroveTheme.hover
        : root.flat ? transparent : GroveTheme.surface;
    border-width: control.has-focus ? 2px : root.flat || root.accent || root.selected ? 0px : 1px;
    border-color: control.has-focus ? GroveTheme.focus : GroveTheme.border;
    opacity: root.enabled ? 1 : 0.6;
    animate background { duration: GroveMotion.fast; easing: ease-out; }
    if root.navigation && root.selected : Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: 3px; height: min(20px, parent.height - 12px);
        border-radius: 2px; background: GroveTheme.accent;
    }
    HorizontalLayout {
        alignment: root.navigation ? start : center; cross-axis-alignment: center; spacing: 10px; padding-left: root.navigation ? 14px : root.text == "" ? 8px : 14px; padding-right: root.text == "" ? 8px : 14px;
        if root.icon != "" : Mark { kind: root.icon; ink: root.ink; width: root.icon-size > 0px ? root.icon-size : root.navigation ? 20px : root.text == "" ? 20px : 18px; height: self.width; }
        if root.text != "" : Text { text: root.text; color: root.ink; font-size: 14px; font-weight: root.selected || root.accent ? 600 : 500; vertical-alignment: center; overflow: elide; }
    }
    touch := TouchArea {
        width: parent.width; height: parent.height; enabled: root.enabled; mouse-cursor: pointer;
        control := Button {
            width: parent.width; height: parent.height;
            text: root.text; accessible-label: root.label != "" ? root.label : root.text == "" ? root.icon : root.text;
            enabled: root.enabled; opacity: 0;
            clicked => { root.clicked(); }
        }
    }
    forward-focus: control;
}

export component Rule inherits Rectangle { height: 1px; background: GroveTheme.line; }

// Artwork, or a stable placeholder gradient with a note mark. Never resizes on load.
export component GroveCover inherits Rectangle {
    in property <image> source;
    in property <string> seed;
    in property <length> radius: GroveTheme.radius-sm;
    border-radius: root.radius;
    clip: true;
    background: GroveTheme.art(mod(root.seed.character-count, 6));
    if root.source.width == 0 : Mark { kind: "note"; ink: #ffffffb0; width: min(parent.width * 0.42, 64px); height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    if root.source.width > 0 : Image { source: root.source; width: parent.width; height: parent.height; image-fit: cover; }
}

// A single-line label that stays inside its box, including right-to-left
// Hebrew and Arabic text, which can otherwise paint past an elided Text.
export component GroveLine inherits Rectangle {
    in property <string> text;
    in property <color> ink: GroveTheme.text;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    in property <TextHorizontalAlignment> align: left;
    height: root.font-size * 1.45;
    min-width: 0px;
    horizontal-stretch: 1;
    clip: true;
    Text { width: parent.width; height: parent.height; text: root.text; color: root.ink; font-size: root.font-size; font-weight: root.font-weight; horizontal-alignment: root.align; vertical-alignment: center; overflow: elide; }
}

// Sidebar destination: icon and label (wide), or a centred icon (rail).
export component GroveNavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <bool> wide: true;
    in property <bool> enabled: true;
    in property <bool> badge: false;
    callback clicked;
    height: 40px;
    border-radius: GroveTheme.radius-sm + 2px;
    background: control.pressed ? GroveTheme.pressed : root.active ? GroveTheme.selected : touch.has-hover ? GroveTheme.hover : transparent;
    border-width: control.has-focus ? 2px : 0px;
    border-color: GroveTheme.focus;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: GroveMotion.fast; easing: ease-out; }
    private property <color> ink: root.active ? GroveTheme.text : touch.has-hover ? GroveTheme.text : GroveTheme.secondary;
    Rectangle {
        x: 0px; y: (parent.height - self.height) / 2;
        width: 3px; height: root.active ? 18px : 0px;
        border-radius: 1.5px; background: GroveTheme.accent;
        animate height { duration: GroveMotion.base; easing: ease-out; }
    }
    Mark {
        kind: root.icon; ink: root.active ? GroveTheme.accent : root.ink;
        x: root.wide ? 14px : (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 20px; height: 20px;
    }
    if root.wide : Text {
        x: 46px; width: parent.width - self.x - 8px; height: parent.height;
        text: root.text; color: root.ink; font-size: 14px; font-weight: root.active ? 650 : 500;
        vertical-alignment: center; overflow: elide;
    }
    if root.badge : Rectangle {
        x: root.wide ? parent.width - 18px : parent.width - 14px; y: root.wide ? (parent.height - 8px) / 2 : 8px;
        width: 8px; height: 8px; border-radius: 4px; background: GroveTheme.accent;
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        control := Button { width: parent.width; height: parent.height; opacity: 0; text: ""; enabled: root.enabled; accessible-label: root.text; clicked => { root.clicked(); } }
    }
    forward-focus: control;
}

// A playlist in the sidebar: artwork with title and owner (wide), or artwork only (rail).
export component GroveSidebarPlaylist inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> cover;
    in property <bool> active;
    in property <bool> wide: true;
    in property <bool> liked: false;
    callback clicked;
    height: 48px;
    border-radius: GroveTheme.radius-sm + 2px;
    background: control.pressed ? GroveTheme.pressed : root.active ? GroveTheme.selected : touch.has-hover ? GroveTheme.hover : transparent;
    border-width: control.has-focus ? 2px : 0px;
    border-color: GroveTheme.focus;
    animate background { duration: GroveMotion.fast; easing: ease-out; }
    HorizontalLayout {
        padding-left: root.wide ? 8px : 0px; padding-right: root.wide ? 8px : 0px; spacing: 10px; alignment: root.wide ? start : center; cross-axis-alignment: center;
        if root.liked : Rectangle {
            width: 36px; height: 36px; border-radius: GroveTheme.radius-sm;
            background: GroveTheme.accent-base;
            Mark { kind: "heart-filled"; ink: GroveTheme.on-accent; width: 18px; height: 18px; x: 9px; y: 9px; }
        }
        if !root.liked : GroveCover { width: 36px; height: 36px; source: root.cover; seed: root.title; }
        if root.wide : VerticalLayout {
            horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 1px;
            GroveLine { text: root.title; ink: root.active ? GroveTheme.accent : GroveTheme.text; font-size: 13px; font-weight: 550; }
            if root.subtitle != "" : GroveLine { text: root.subtitle; ink: GroveTheme.muted; font-size: 11px; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        control := Button { width: parent.width; height: parent.height; opacity: 0; text: ""; accessible-label: "Open " + root.title; clicked => { root.clicked(); } }
    }
    forward-focus: control;
}

// A pill-shaped toggle or quiet action.
export component GroveChip inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    min-width: chip-layout.min-width;
    border-radius: self.height / 2;
    background: !root.enabled ? transparent : control.pressed ? GroveTheme.pressed : root.active ? GroveTheme.accent-soft : touch.has-hover ? GroveTheme.hover : transparent;
    border-width: control.has-focus ? 2px : 1px;
    border-color: control.has-focus ? GroveTheme.focus : root.active ? GroveTheme.accent : GroveTheme.border;
    opacity: root.enabled ? 1 : 0.5;
    animate background, border-color { duration: GroveMotion.fast; easing: ease-out; }
    chip-layout := HorizontalLayout {
        padding-left: 12px; padding-right: 14px; spacing: 6px; cross-axis-alignment: center;
        if root.icon != "" : Mark { kind: root.icon; ink: root.active ? GroveTheme.accent : GroveTheme.secondary; width: 16px; height: 16px; }
        Text { text: root.text; color: root.active ? GroveTheme.text : GroveTheme.secondary; font-size: 13px; font-weight: 550; vertical-alignment: center; }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        control := Button { width: parent.width; height: parent.height; opacity: 0; text: ""; enabled: root.enabled; accessible-label: root.label != "" ? root.label : root.text; clicked => { root.clicked(); } }
    }
    forward-focus: control;
}

// Grouped content on a raised surface.
export component GroveCard inherits Rectangle {
    in property <bool> elevated: false;
    background: GroveTheme.surface;
    border-radius: GroveTheme.radius-lg;
    border-width: 1px;
    border-color: GroveTheme.line;
    drop-shadow-blur: root.elevated ? GroveTheme.elevation-2 : 0px;
    drop-shadow-offset-y: root.elevated ? 6px : 0px;
    drop-shadow-color: GroveTheme.shadow;
}

// Small caps section heading.
export component GroveEyebrow inherits Text {
    color: GroveTheme.muted; font-size: 11px; font-weight: 700; letter-spacing: 0.9px;
    vertical-alignment: center;
}

// A centred message for empty or failed panels.
export component GroveEmpty inherits VerticalLayout {
    in property <string> heading;
    in property <string> detail;
    in property <string> icon: "note";
    alignment: center; spacing: 10px;
    padding: 24px;
    HorizontalLayout { alignment: center; Rectangle { width: 52px; height: 52px; border-radius: 26px; background: GroveTheme.accent-soft; Mark { kind: root.icon; ink: GroveTheme.accent; width: 24px; height: 24px; x: 14px; y: 14px; } } }
    Text { text: root.heading; color: GroveTheme.text; font-size: 16px; font-weight: 650; horizontal-alignment: center; wrap: word-wrap; }
    if root.detail != "" : Text { text: root.detail; color: GroveTheme.muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
}

export component SongRow inherits Rectangle {
    in property <GroveFeatureTrack> song;
    in property <bool> saved: false;
    in property <bool> can-remove: false;
    in property <bool> can-play;
    in property <bool> busy;
    callback action(string,string);
    private property <bool> expanded: false;
    height: root.expanded ? 150px : 62px;
    border-radius: GroveTheme.radius-md;
    background: root.expanded ? GroveTheme.surface : hover.has-hover ? GroveTheme.hover : transparent;
    animate background { duration: GroveMotion.fast; easing: ease-out; }
    animate height { duration: GroveMotion.base; easing: ease-out; }
    clip: true;
    hover := TouchArea { }
    VerticalLayout {
        spacing: 5px; padding-left: 8px; padding-right: 8px; padding-top: 9px; padding-bottom: 9px;
        HorizontalLayout {
            spacing: 12px; height: 44px;
            GroveCover { width: 44px; height: 44px; source: root.song.cover; seed: root.song.title; }
            VerticalLayout {
                alignment: center; spacing: 2px; horizontal-stretch: 1; min-width: 0px;
                GroveLine { text: root.song.title; ink: GroveTheme.text; font-size: 14px; font-weight: 550; }
                GroveLine { text: root.song.artist; ink: GroveTheme.muted; font-size: 12px; }
            }
            Text { text: root.song.duration; color: GroveTheme.muted; font-size: 12px; width: 40px; vertical-alignment: center; horizontal-alignment: right; }
            GroveButton { icon: "play"; flat: true; round: true; width: 38px; height: 38px; label: "Play " + root.song.title; enabled: root.can-play; clicked => { root.action("play",root.song.uri); } }
            GroveButton { icon: "more"; flat: true; round: true; width: 38px; height: 38px; label: root.expanded ? "Hide song actions" : "Song actions"; selected: root.expanded; clicked => { root.expanded = !root.expanded; } }
        }
        if root.expanded : HorizontalLayout {
            spacing: 8px; alignment: start; padding-left: 56px;
            GroveButton { text: "Play next"; width: 130px; height: 36px; enabled: !root.busy; clicked => { root.action("Next",root.song.uri); root.expanded = false; } }
            GroveButton { text: "Add to queue"; width: 130px; height: 36px; enabled: !root.busy; clicked => { root.action("Queue",root.song.uri); root.expanded = false; } }
            GroveButton { text: root.saved ? "Unlike" : "Like"; width: 130px; height: 36px; enabled: !root.busy; clicked => { root.action(root.saved ? "Unsave" : "Save",root.song.uri); root.expanded = false; } }
        }
        if root.expanded : HorizontalLayout {
            spacing: 8px; alignment: start; padding-left: 56px;
            GroveButton { text: "View artist"; width: 130px; height: 36px; enabled: !root.busy; clicked => { root.action("Artist",root.song.uri); root.expanded = false; } }
            GroveButton { text: "Add to playlist"; width: 130px; height: 36px; enabled: !root.busy; clicked => { root.action("Playlist",root.song.uri); root.expanded = false; } }
            GroveButton { text: root.can-remove ? "Remove song" : "Hide song"; width: 130px; height: 36px; enabled: !root.busy; clicked => { root.action(root.can-remove ? "Remove" : "Hide",root.song.uri); root.expanded = false; } }
        }
    }
}

// Keep Slint's pointer, keyboard and accessibility behavior under a quiet skin.
export component GroveSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 0;
    in property <bool> enabled: true;
    in property <string> label;
    callback released(float);
    private property <float> preview: root.value;
    private property <bool> interacting: false;
    private property <bool> input-focused: native.has-focus;
    private property <bool> lit: (touch.has-hover || root.interacting || native.has-focus) && root.enabled;
    private property <float> fraction: root.maximum > root.minimum ? min(1, max(0, (root.preview - root.minimum) / (root.maximum - root.minimum))) : 0;
    changed value => { if !root.interacting { root.preview = root.value; } }
    changed maximum => { root.interacting = false; root.preview = root.value; }
    changed enabled => { root.interacting = false; root.preview = root.value; }
    changed input-focused => { if !root.input-focused { root.interacting = false; root.preview = root.value; } }
    min-width: 40px; min-height: 20px; horizontal-stretch: 1;
    forward-focus: native;
    function commit(value: float) {
        if root.enabled {
            root.interacting = false;
            root.released(min(root.maximum, max(root.minimum, value)));
            root.preview = root.value;
        }
    }
    Rectangle {
        x: 6px; y: (parent.height - self.height) / 2;
        width: max(0px, parent.width - 12px); height: root.lit ? 5px : 4px;
        background: GroveTheme.pressed; border-radius: 2.5px;
        animate height { duration: GroveMotion.fast; }
    }
    Rectangle {
        x: 6px; y: (parent.height - self.height) / 2;
        width: max(0px, parent.width - 12px) * root.fraction; height: root.lit ? 5px : 4px;
        background: !root.enabled ? GroveTheme.disabled : root.lit ? GroveTheme.accent : GroveTheme.text.with-alpha(0.85); border-radius: 2.5px;
        animate height { duration: GroveMotion.fast; }
    }
    Rectangle {
        x: max(0px, parent.width - 12px) * root.fraction; y: (parent.height - 12px) / 2;
        width: 12px; height: 12px; border-radius: 6px;
        background: root.enabled ? GroveTheme.text : GroveTheme.disabled;
        opacity: root.lit || !root.enabled ? 1 : 0;
        border-width: native.has-focus ? 2px : 0px; border-color: GroveTheme.focus;
        animate opacity { duration: GroveMotion.fast; }
    }
    touch := TouchArea {
        native := Slider {
            width: parent.width; height: parent.height; opacity: 0;
            minimum: root.minimum; maximum: root.maximum; value <=> root.preview;
            enabled: root.enabled; accessible-label: root.label;
            accessible-action-set-value(value) => { if value.is-float() { root.commit(value.to-float()); } }
            accessible-action-increment => { root.commit(root.value + 1); }
            accessible-action-decrement => { root.commit(root.value - 1); }
            changed(value) => { root.interacting = true; }
            released(value) => { root.commit(value); }
        }
    }
}

// The full sidebar (Home, Search, Library, Shared jams and your playlists with
// artwork). Narrow windows collapse it to an icon rail.
export component GroveSidebar inherits Rectangle {
    in-out property <int> page;
    in property <bool> wide: true;
    in property <bool> library-ready;
    in property <bool> jam-connected;
    in property <string> collection-uri;
    in property <string> account-name;
    in property <[GrovePlaylist]> playlists;
    in property <[image]> playlist-covers;
    callback open-collection(string, string);
    width: root.wide ? 248px : 72px;
    background: GroveTheme.chrome;
    Rectangle { x: parent.width - 1px; width: 1px; background: GroveTheme.line; }
    VerticalLayout {
        padding-left: root.wide ? 12px : 10px; padding-right: root.wide ? 12px : 10px; padding-top: 16px; padding-bottom: 12px;
        spacing: 2px;
        HorizontalLayout {
            height: 48px; spacing: 10px; padding-left: root.wide ? 8px : 0px; alignment: root.wide ? start : center; cross-axis-alignment: center;
            Image { source: @image-url("../assets/grove/logo-split-disc.svg"); width: 30px; height: 30px; image-fit: contain; accessible-role: image; accessible-label: "Grove"; }
            if root.wide : Text { text: "Grove"; color: GroveTheme.text; font-size: 22px; font-weight: 750; letter-spacing: -0.3px; vertical-alignment: center; }
        }
        Rectangle { height: 6px; }
        GroveNavItem { text: "Home"; icon: "home"; wide: root.wide; active: root.page == 5; clicked => { root.page = 5; } }
        GroveNavItem { text: "Search"; icon: "search"; wide: root.wide; active: root.page == 6; clicked => { root.page = 6; } }
        GroveNavItem { text: "Library"; icon: "library"; wide: root.wide; active: root.page == 3; clicked => { root.page = 3; } }
        GroveNavItem { text: "Shared jams"; icon: "people"; wide: root.wide; badge: root.jam-connected; active: root.page == 4; clicked => { root.page = 4; } }
        Rectangle { height: 14px; Rectangle { x: root.wide ? 8px : 6px; y: 7px; width: parent.width - 2 * self.x; height: 1px; background: GroveTheme.line; } }
        if root.wide : HorizontalLayout {
            height: 26px; padding-left: 10px;
            GroveEyebrow { text: "YOUR PLAYLISTS"; }
        }
        if root.library-ready : GroveSidebarPlaylist { title: "Liked Songs"; subtitle: root.wide ? "Your saved songs" : ""; liked: true; wide: root.wide; active: root.page == 10 && root.collection-uri == "liked"; clicked => { root.open-collection("liked", "Liked Songs"); } }
        if root.library-ready : ListView {
            vertical-stretch: 1; min-height: 0px;
            accessible-label: "Your playlists";
            horizontal-scrollbar-policy: always-off;
            for playlist[index] in root.playlists : GroveSidebarPlaylist {
                title: playlist.title; subtitle: playlist.subtitle; wide: root.wide;
                cover: index < root.playlist-covers.length ? root.playlist-covers[index] : root.no-cover;
                active: root.page == 10 && root.collection-uri == playlist.uri;
                clicked => { root.open-collection(playlist.uri, playlist.title); }
            }
        }
        if !root.library-ready && root.wide : Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start; padding: 10px; spacing: 10px;
                Text { text: "Connect Spotify to see your playlists here."; color: GroveTheme.muted; font-size: 12px; wrap: word-wrap; }
                GroveButton { text: "Connect"; round: true; height: 34px; width: 110px; clicked => { root.page = 2; } }
            }
        }
        if !root.library-ready && !root.wide : Rectangle { vertical-stretch: 1; }
        Rectangle { height: 10px; Rectangle { x: root.wide ? 8px : 6px; y: 4px; width: parent.width - 2 * self.x; height: 1px; background: GroveTheme.line; } }
        GroveNavItem { text: "Settings"; icon: "settings"; wide: root.wide; active: root.page == 8; clicked => { root.page = 8; } }
        GroveNavItem { text: root.library-ready && root.account-name != "" ? root.account-name : "Account"; icon: "user"; wide: root.wide; active: root.page == 2; clicked => { root.page = 2; } }
    }
    private property <image> no-cover;
}
