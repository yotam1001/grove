import { LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { GroveTrack, GrovePlaylist, GroveJamTrack, GroveFeatureTrack, GroveLyricLine } from "model.slint";
import { GroveTheme, GroveMotion } from "theme.slint";
import { GroveButton, GroveSidebar, Rule } from "components.slint";
import { PlayerBar } from "player.slint";
import { PlaylistEditor } from "pages/playlist_editor.slint";
import { AccountPage } from "pages/account.slint";
import { FeatureListPage, HomePage } from "pages/home_search.slint";
import { SearchPage } from "pages/search.slint";
import { CollectionPage } from "pages/collection.slint";
import { ArtistPage } from "pages/artist.slint";
import { GroveBrowse, GroveCard, GroveShelf, GroveRow, GroveHeader } from "browse_model.slint";
import { JamsPage } from "pages/jams.slint";
import { LibraryPage } from "pages/library.slint";
import { NowPlayingView } from "pages/now_playing.slint";
import { QueueDrawer } from "pages/queue.slint";
import { SettingsPage } from "pages/settings.slint";
import { GroveSystem, CrashNotice } from "system.slint";

export { GroveTrack, GrovePlaylist, GroveJamTrack, GroveFeatureTrack, GroveLyricLine, GroveTheme, GroveMotion }
export { GroveSystem }
export { GroveBrowse, GroveCard, GroveShelf, GroveRow, GroveHeader }
export { GroveAudio, GroveChoice, GroveBand, GroveSaved } from "pages/settings_audio.slint";

// The window keeps every property and callback the Rust side uses; pages and the
// player bar receive them through bindings.
export component GroveWindow inherits Window {
    in property <string> app-version;
    private property <bool> show-about: false;
    callback save-support;
    title: "Grove";
    icon: @image-url("../assets/grove/logo-split-disc.svg");
    preferred-width: 1200px; preferred-height: 800px;
    min-width: root.mini ? 560px : 700px; min-height: root.mini ? 100px : 540px;
    background: GroveTheme.canvas;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    in-out property <int> page: 5;
    private property <bool> account-options: false;
    private property <bool> network-options: false;
    private property <bool> show-link: false;
    in-out property <bool> mini: false;
    in-out property <bool> light-mode: false;
    in property <bool> compact-mode: false;
    in property <bool> feature-busy: false;
    in property <string> feature-message;
    in property <[GroveFeatureTrack]> feature-tracks;
    in property <string> feature-title;
    in-out property <string> search-text;
    in property <bool> feature-more: false;
    in property <image> current-cover;
    in property <string> current-uri;
    in property <bool> current-saved: false;
    in property <bool> autoplay: false;
    in property <bool> media-keys: true;
    in property <bool> local-history: false;
    in property <bool> local-active: false;
    callback open-local;
    callback stop-local;
    in property <[GroveTrack]> local-queue;
    in property <bool> playlists-more: false;
    in-out property <string> edit-track;
    in-out property <string> edit-playlist;
    in property <bool> removing-from-playlist: false;
    in property <bool> collection-owned: false;
    callback page-changed(int);
    callback search(string);
    callback feature-refresh;
    callback feature-next;
    callback feature-back;
    callback song-action(string,string);
    callback appearance(string);
    callback media-command(int,float);
    callback playlist-edit(bool);
    callback library-more;
    callback queue-edit(string,int);
    callback play-selection(bool);
    private property <bool> narrow: false;
    private property <bool> wide: true;
    in-out property <string> client-id;
    in property <bool> library-ready: false;
    in property <string> account-name: "Not signed in";
    in property <[GrovePlaylist]> playlists;
    in property <[GrovePlaylist]> owned-playlists;
    in-out property <string> collection-uri;
    in-out property <string> collection-title;
    in property <string> library-note;
    in-out property <string> link;
    in-out property <string> jam-name: "Listener";
    in-out property <string> jam-address: "127.0.0.1";
    in-out property <string> jam-join-invite;
    in-out property <string> jam-track-link;
    in-out property <string> jam-track-title;
    in property <string> jam-invite;
    in property <string> jam-members;
    in property <string> jam-message;
    in property <string> jam-sync-status: "Not in a jam";
    in property <bool> jam-connected: false;
    in property <bool> jam-busy: false;
    in property <bool> jam-host: false;
    in-out property <bool> jam-following: true;
    in property <[GroveJamTrack]> jam-tracks;
    in property <bool> jam-matching: false;
    in property <bool> jam-tide-host: false;
    in property <bool> jam-match-confirmed: false;
    in property <string> jam-match-title;
    in-out property <string> jam-match-link;
    in property <[GroveFeatureTrack]> jam-matches;
    private property <bool> following-guest: root.jam-connected && !root.jam-host && root.jam-following;
    in property <bool> connected: false;
    in property <bool> authenticated: false;
    in property <bool> playing: false;
    in property <bool> connecting: false;
    in property <bool> can-seek: false;
    in property <bool> can-play: false;
    in property <bool> can-pause: false;
    in property <bool> can-next: false;
    in property <bool> can-previous: false;
    in property <bool> can-queue: false;
    in property <bool> can-shuffle: false;
    in property <bool> can-repeat: false;
    in property <bool> shuffle: false;
    in property <bool> repeat: false;
    in property <string> track-title: "Nothing playing yet";
    in property <string> artist: "Connect Spotify to start listening";
    in property <string> context-name: "Spotify Connect";
    in property <string> status: "Not connected";
    // Audio stream: sleep-timer countdown and a lost session being restored.
    in property <string> sleep-remaining;
    in property <string> reconnecting;
    // Offline review modes scroll the page to the section they capture.
    in property <length> review-scroll;
    in property <string> message;
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <float> volume: 35;
    in property <string> elapsed: "0:00";
    in property <string> total: "0:00";
    in property <[GroveTrack]> tracks;
    callback connect-engine;
    callback sign-in-library;
    callback sign-out;
    callback cancel-sign-in;
    callback approve-playback;
    callback refresh-library;
    callback browse(string, string);
    callback play-uri(string);
    callback disconnect-engine;
    callback play-link;
    callback enqueue-link;
    callback transport(string);
    callback seek(float);
    callback set-volume(float);
    callback switch-mini;
    callback jam-create;
    callback jam-join;
    callback jam-leave;
    callback jam-add;
    callback jam-remove(string);
    callback jam-next;
    callback jam-pair(int);


    // ── Shell (issue #41) ──
    // Sidebar: playlist artwork, parallel to `playlists`.
    in property <[image]> playlist-covers;
    // Back/forward history, kept by the Rust side.
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    callback navigate-back;
    callback navigate-forward;
    // The queue drawer (#27).
    in-out property <bool> queue-open: false;
    in property <[GroveTrack]> autoplay-queue;
    in-out property <string> queue-query;
    in property <[GroveTrack]> queue-search-results;
    in property <[int]> queue-search-index;
    in property <[GroveFeatureTrack]> related-tracks;
    in property <int> related-state: 0;
    in property <string> related-note;
    callback queue-move(int,int);
    callback queue-filter(string);
    callback load-related;
    callback related-action(string,int);
    callback autoplay-action(string,int);
    // Hide beside Like (#30): hidden songs never autoplay.
    in property <bool> current-hidden: false;
    callback hide-current(bool);
    // Immersive Now Playing (#13) and synced lyrics (#12).
    in property <string> current-album;
    in property <image> now-playing-backdrop;
    in property <image> now-playing-cover;
    in-out property <int> now-playing-tab: 0;
    in-out property <bool> accent-follows-art: false;
    in property <[GroveLyricLine]> lyrics-lines;
    in property <int> lyrics-active: -1;
    in property <bool> lyrics-synced: false;
    in property <int> lyrics-state: 0;
    in property <string> lyrics-status;
    in property <string> lyrics-source;
    callback lyrics-seek(int);
    callback lyrics-retry;
    out property <bool> now-playing-visible: root.page == 0 && !root.mini;
    out property <bool> lyrics-open: root.now-playing-visible && root.now-playing-tab == 0;
    // Set from width changes (not bound) so window layout cannot loop.
    out property <bool> sidebar-wide: true;
    private property <bool> dock-room: false;
    private property <bool> queue-docked: root.queue-open && root.dock-room;
    private property <int> before-now-playing: 5;
    // True for the first frame of a page change; the fade and slide run as it clears.
    in-out property <bool> page-entering: false;
    private property <length> player-height: 88px;
    private property <image> no-image;

    init => { Palette.color-scheme = root.light-mode ? ColorScheme.light : ColorScheme.dark; GroveTheme.light = root.light-mode; GroveTheme.follow-art = root.accent-follows-art; root.narrow = root.width < 880px; root.wide = root.width >= 1000px; root.sidebar-wide = !root.compact-mode && root.width >= 880px; root.dock-room = root.width >= 1360px; }
    changed compact-mode => { root.sidebar-wide = !root.compact-mode && root.width >= 880px; }
    changed accent-follows-art => { GroveTheme.follow-art = root.accent-follows-art; }
    changed light-mode => { GroveTheme.light = root.light-mode; Palette.color-scheme = root.light-mode ? ColorScheme.light : ColorScheme.dark; }
    changed page => {
        // The queue is a drawer now; page 1 opens it over Now Playing.
        if root.page == 1 {
            root.queue-open = true;
            root.page = 0;
        } else {
            if root.page != 0 { root.before-now-playing = root.page; }
            root.show-link = false;
            root.page-entering = true;
            root.page-changed(root.page);
        }
    }
    // One frame at the start position, then a short fade and slide in.
    Timer { interval: 16ms; running: root.page-entering; triggered => { root.page-entering = false; } }
    changed width => { root.narrow = root.width < 880px; root.wide = root.width >= 1000px; root.sidebar-wide = !root.compact-mode && root.width >= 880px; root.dock-room = root.width >= 1360px; }

    forward-focus: window-keys;
    // Space and arrows reach the player unless a text field has focus; a
    // focused slider keeps its own arrow keys. See crates/grove/src/shortcuts.rs.
    window-keys := FocusScope {
    capture-key-pressed(event) => { if event.text == " " && !TextInputInterface.text-input-focused && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && GroveSystem.shortcut-recording-index < 0 && !event.repeat { if GroveSystem.window-key("space") { return accept; } } return reject; }
    key-pressed(event) => { if (event.text == Key.LeftArrow || event.text == Key.RightArrow) && !TextInputInterface.text-input-focused && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift { if GroveSystem.window-key(event.text == Key.LeftArrow ? "left" : "right") { return accept; } } return reject; }
    VerticalLayout {
        spacing: 0; padding: 0;
        if !root.mini : HorizontalLayout {
            spacing: 0;
            GroveSidebar {
                page <=> root.page;
                wide: root.sidebar-wide;
                library-ready: root.library-ready;
                jam-connected: root.jam-connected;
                collection-uri: root.collection-uri;
                account-name: root.account-name;
                playlists: root.playlists;
                playlist-covers: root.playlist-covers;
                open-collection(uri, title) => { root.browse(uri, title); }
            }
            ScrollView {
                private property <int> shown-page: root.page;
                changed shown-page => { self.content-y = 0px; }
                private property <length> review-offset: root.review-scroll;
                changed review-offset => { self.content-y = -self.review-offset; }
                horizontal-stretch: 1;
                opacity: root.page-entering ? 0 : 1;
                animate opacity { duration: root.page-entering ? 0ms : GroveMotion.base; easing: ease-out; }
                VerticalLayout {
                    padding: root.narrow || root.compact-mode ? 24px : 38px; spacing: root.compact-mode ? 16px : 22px;
                    padding-top: (root.narrow || root.compact-mode ? 16px : 24px) + (root.page-entering ? 12px : 0px);
                    animate padding-top { duration: root.page-entering ? 0ms : GroveMotion.base; easing: ease-out; }
                    HorizontalLayout {
                        spacing: 8px; vertical-stretch: 0; height: 36px; alignment: start;
                        GroveButton { icon: "back"; round: true; width: 34px; height: 34px; icon-size: 18px; label: "Back"; enabled: root.can-go-back; clicked => { root.navigate-back(); } }
                        GroveButton { icon: "forward"; round: true; width: 34px; height: 34px; icon-size: 18px; label: "Forward"; enabled: root.can-go-forward; clicked => { root.navigate-forward(); } }
                    }
                    // Collection (10) and artist (11) pages draw their own header.
                    if root.page < 10 : HorizontalLayout {
                        spacing: 16px; vertical-stretch: 0;
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: root.page == 9 ? "Listening history" : root.page == 8 ? "Settings" : root.page == 7 ? root.feature-title : root.page == 6 ? "Search" : root.page == 5 ? "Home" : root.page == 4 ? "Shared jams" : root.page == 2 ? "Spotify" : root.page == 3 ? "Your library" : root.page == 1 ? "Your queue" : "Now playing"; color: GroveTheme.text; font-size: root.narrow ? 26px : 34px; font-weight: 750; overflow: elide; }
                            Text { text: root.page == 9 ? "Songs from this session." : root.page == 8 ? "Make yourself at home." : root.page == 7 ? "Browse this artist without interrupting playback." : root.page == 6 ? "Find music on Spotify." : root.page == 5 ? root.library-ready ? "Your favorites, ready to play." : "Your music in one place." : root.page == 4 ? "Listen together, on your own devices." : root.page == 2 ? "Your Spotify account." : root.page == 3 ? root.account-name : root.page == 1 ? "Your next songs, in order." : "Pick up where you left off."; color: GroveTheme.muted; font-size: 15px; wrap: word-wrap; }
                        }
                    }
                    if root.message != "" : Text { text: root.message; color: GroveTheme.warning; font-size: 13px; wrap: word-wrap; }
                    if root.feature-message != "" : Text { text: root.feature-message; color: GroveTheme.secondary; font-size: 13px; wrap: word-wrap; }
                    if GroveSystem.crash-pending : CrashNotice {}
                    if root.edit-track != "" : PlaylistEditor {
                        removing-from-playlist: root.removing-from-playlist;
                        collection-title: root.collection-title;
                        owned-playlists: root.owned-playlists;
                        edit-playlist <=> root.edit-playlist;
                        edit-track <=> root.edit-track;
                        playlist-edit(a) => { root.playlist-edit(a); }
                    }
                    if root.page == 8 : SettingsPage {
                        light-mode: root.light-mode;
                        compact-mode: root.compact-mode;
                        jam-connected: root.jam-connected;
                        local-active: root.local-active;
                        media-keys: root.media-keys;
                        autoplay: root.autoplay;
                        local-history: root.local-history;
                        app-version: root.app-version;
                        page <=> root.page;
                        show-about <=> root.show-about;
                        appearance(a) => { root.appearance(a); }
                        open-local => { root.open-local(); }
                        stop-local => { root.stop-local(); }
                        save-support => { root.save-support(); }
                    }
                    if root.page == 5 : HomePage {
                        page <=> root.page;
                        library-ready: root.library-ready;
                        busy: root.feature-busy;
                        can-play: root.authenticated && !root.following-guest;
                        narrow: root.narrow;
                        current-uri: root.current-uri;
                        open-local => { root.open-local(); }
                    }
                    if root.page == 6 : SearchPage {
                        search-text <=> root.search-text;
                        library-ready: root.library-ready;
                        busy: root.feature-busy;
                        can-play: root.authenticated && !root.following-guest;
                        narrow: root.narrow;
                        feature-more: root.feature-more;
                        search(a) => { root.search(a); }
                        feature-next => { root.feature-next(); }
                    }
                    if root.page == 10 : CollectionPage {
                        busy: root.feature-busy;
                        can-play: root.authenticated && !root.following-guest;
                        narrow: root.narrow;
                        feature-more: root.feature-more;
                        feature-back => { root.feature-back(); }
                        feature-next => { root.feature-next(); }
                    }
                    if root.page == 11 : ArtistPage {
                        busy: root.feature-busy;
                        can-play: root.authenticated && !root.following-guest;
                        narrow: root.narrow;
                        feature-back => { root.feature-back(); }
                    }
                    if root.page == 7 || root.page == 9 : FeatureListPage {
                        page <=> root.page;
                        library-ready: root.library-ready;
                        feature-busy: root.feature-busy;
                        feature-tracks: root.feature-tracks;
                        collection-title: root.collection-title;
                        collection-uri: root.collection-uri;
                        collection-owned: root.collection-owned;
                        current-uri: root.current-uri;
                        current-saved: root.current-saved;
                        authenticated: root.authenticated;
                        following-guest: root.following-guest;
                        jam-connected: root.jam-connected;
                        local-history: root.local-history;
                        feature-more: root.feature-more;
                        search-text <=> root.search-text;
                        open-local => { root.open-local(); }
                        feature-back => { root.feature-back(); }
                        search(a) => { root.search(a); }
                        play-selection(a) => { root.play-selection(a); }
                        feature-refresh => { root.feature-refresh(); }
                        song-action(a, b) => { root.song-action(a, b); }
                        feature-next => { root.feature-next(); }
                    }
                    if root.page == 4 : JamsPage {
                        jam-message: root.jam-message;
                        jam-connected: root.jam-connected;
                        jam-name <=> root.jam-name;
                        jam-busy: root.jam-busy;
                        network-options <=> root.network-options;
                        jam-address <=> root.jam-address;
                        jam-join-invite <=> root.jam-join-invite;
                        jam-host: root.jam-host;
                        jam-sync-status: root.jam-sync-status;
                        jam-following <=> root.jam-following;
                        jam-matching: root.jam-matching;
                        jam-match-confirmed: root.jam-match-confirmed;
                        jam-match-title: root.jam-match-title;
                        jam-matches: root.jam-matches;
                        jam-match-link <=> root.jam-match-link;
                        jam-invite: root.jam-invite;
                        jam-members: root.jam-members;
                        jam-tide-host: root.jam-tide-host;
                        jam-track-link <=> root.jam-track-link;
                        jam-track-title <=> root.jam-track-title;
                        authenticated: root.authenticated;
                        jam-tracks: root.jam-tracks;
                        jam-create => { root.jam-create(); }
                        jam-join => { root.jam-join(); }
                        jam-leave => { root.jam-leave(); }
                        jam-pair(a) => { root.jam-pair(a); }
                        jam-add => { root.jam-add(); }
                        jam-next => { root.jam-next(); }
                        jam-remove(a) => { root.jam-remove(a); }
                    }
                    if root.page == 3 : LibraryPage {
                        page <=> root.page;
                        library-ready: root.library-ready;
                        collection-uri <=> root.collection-uri;
                        collection-title <=> root.collection-title;
                        library-note: root.library-note;
                        playlists: root.playlists;
                        playlists-more: root.playlists-more;
                        busy: root.feature-busy;
                        can-play: root.authenticated && !root.following-guest;
                        narrow: root.narrow;
                        browse(a, b) => { root.browse(a, b); }
                        refresh-library => { root.refresh-library(); }
                        library-more => { root.library-more(); }
                    }
                    if root.page == 2 : AccountPage {
                        library-ready: root.library-ready;
                        account-name: root.account-name;
                        authenticated: root.authenticated;
                        connecting: root.connecting;
                        account-options <=> root.account-options;
                        client-id <=> root.client-id;
                        connect-engine => { root.connect-engine(); }
                        sign-in-library => { root.sign-in-library(); }
                        cancel-sign-in => { root.cancel-sign-in(); }
                        sign-out => { root.sign-out(); }
                        approve-playback => { root.approve-playback(); }
                    }
                    Rectangle { min-height: 10px; vertical-stretch: 1; background: transparent; }
                }
            }
            if root.queue-docked : QueueDrawer {
                width: 340px;
                local-queue: root.local-queue;
                tracks: root.tracks;
                autoplay-next: root.autoplay-queue;
                autoplay: root.autoplay;
                can-play: root.authenticated && !root.following-guest;
                current-title: root.track-title;
                current-artist: root.artist;
                current-cover: root.current-cover;
                has-current: root.current-uri != "" || root.local-active;
                related: root.related-tracks;
                related-state: root.related-state;
                related-note: root.related-note;
                query <=> root.queue-query;
                search-results: root.queue-search-results;
                search-index: root.queue-search-index;
                link <=> root.link;
                can-add-link: root.library-ready;
                message: root.message;
                enqueue-link => { root.enqueue-link(); }
                queue-edit(a, b) => { root.queue-edit(a, b); }
                queue-move(a, b) => { root.queue-move(a, b); }
                queue-filter(q) => { root.queue-filter(q); }
                load-related => { root.load-related(); }
                related-action(a, b) => { root.related-action(a, b); }
                autoplay-action(a, b) => { root.autoplay-action(a, b); }
                toggle-autoplay => { root.appearance("autoplay"); }
                close => { root.queue-open = false; }
            }
        }
        PlayerBar {
            mini: root.mini;
            narrow: root.narrow;
            current-cover: root.current-cover;
            local-active: root.local-active;
            authenticated: root.authenticated;
            track-title: root.track-title;
            artist: root.artist;
            library-ready: root.library-ready;
            current-uri: root.current-uri;
            shuffle: root.shuffle;
            can-shuffle: root.can-shuffle;
            following-guest: root.following-guest;
            can-previous: root.can-previous;
            playing: root.playing;
            can-pause: root.can-pause;
            can-play: root.can-play;
            can-next: root.can-next;
            repeat: root.repeat;
            can-repeat: root.can-repeat;
            current-saved: root.current-saved;
            elapsed: root.elapsed;
            duration: root.duration;
            position: root.position;
            can-seek: root.can-seek;
            total: root.total;
            volume: root.volume;
            status: root.status;
            reconnecting: root.reconnecting;
            sleep-remaining: root.sleep-remaining;
            song-action(a, b) => { root.song-action(a, b); }
            transport(a) => { root.transport(a); }
            seek(a) => { root.seek(a); }
            set-volume(a) => { root.set-volume(a); }
            switch-mini => { root.switch-mini(); }
            current-hidden: root.current-hidden;
            queue-open: root.queue-open;
            lyrics-open: root.lyrics-open;
            now-playing-open: root.now-playing-visible;
            hide-current(h) => { root.hide-current(h); }
            toggle-queue => { root.queue-open = !root.queue-open; }
            toggle-lyrics => {
                if root.lyrics-open { root.page = root.before-now-playing; }
                else { root.now-playing-tab = 0; root.page = 0; }
            }
            open-now-playing => {
                if root.now-playing-visible { root.page = root.before-now-playing; }
                else { root.page = 0; }
            }
        }
    }

    // Immersive Now Playing covers the content area, beside the sidebar.
    if root.now-playing-visible : NowPlayingView {
        x: root.sidebar-wide ? 248px : 72px; y: 0px;
        width: root.width - self.x - (root.queue-docked ? 340px : 0px);
        height: root.height - root.player-height;
        track-title: root.track-title;
        artist: root.artist;
        album: root.current-album;
        context-name: root.context-name;
        cover: root.local-active ? root.no-image : root.now-playing-cover.width > 0 ? root.now-playing-cover : root.current-cover;
        backdrop: root.now-playing-backdrop;
        playing: root.playing;
        has-track: root.current-uri != "" || root.local-active;
        current-saved: root.current-saved && !root.local-active;
        current-hidden: root.current-hidden;
        can-rate: root.library-ready && root.current-uri != "" && !root.local-active;
        artist-enabled: root.library-ready && root.current-uri != "" && !root.local-active;
        follow-art: root.accent-follows-art;
        up-next: root.local-queue;
        autoplay-next: root.autoplay ? root.autoplay-queue : [];
        lyrics-lines: root.lyrics-lines;
        lyrics-active: root.lyrics-active;
        lyrics-synced: root.lyrics-synced;
        lyrics-state: root.lyrics-state;
        lyrics-status: root.lyrics-status;
        lyrics-source: root.lyrics-source;
        lyrics-seek-enabled: root.can-seek && !root.following-guest;
        tab <=> root.now-playing-tab;
        show-link <=> root.show-link;
        link <=> root.link;
        can-play-link: root.authenticated && !root.following-guest;
        message: root.message;
        play-link => { root.play-link(); }
        song-action(a, b) => { root.song-action(a, root.current-uri); }
        hide-current(h) => { root.hide-current(h); }
        toggle-follow-art => { root.appearance("accent-art"); }
        lyrics-seek(i) => { root.lyrics-seek(i); }
        lyrics-retry => { root.lyrics-retry(); }
        open-queue => { root.queue-open = true; }
        close => { root.page = root.before-now-playing; }
    }

    // Narrower windows: the queue drawer slides over the content with a scrim.
    if root.queue-open && !root.queue-docked && !root.mini : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height - root.player-height;
        Rectangle {
            background: GroveTheme.scrim;
            TouchArea { clicked => { root.queue-open = false; } }
        }
        QueueDrawer {
            x: parent.width - self.width; width: min(360px, parent.width - 40px); height: parent.height;
            local-queue: root.local-queue;
            tracks: root.tracks;
            autoplay-next: root.autoplay-queue;
            autoplay: root.autoplay;
            can-play: root.authenticated && !root.following-guest;
            current-title: root.track-title;
            current-artist: root.artist;
            current-cover: root.current-cover;
            has-current: root.current-uri != "" || root.local-active;
            related: root.related-tracks;
            related-state: root.related-state;
            related-note: root.related-note;
            query <=> root.queue-query;
            search-results: root.queue-search-results;
            search-index: root.queue-search-index;
            link <=> root.link;
            can-add-link: root.library-ready;
            message: root.message;
            enqueue-link => { root.enqueue-link(); }
            queue-edit(a, b) => { root.queue-edit(a, b); }
            queue-move(a, b) => { root.queue-move(a, b); }
            queue-filter(q) => { root.queue-filter(q); }
            load-related => { root.load-related(); }
            related-action(a, b) => { root.related-action(a, b); }
            autoplay-action(a, b) => { root.autoplay-action(a, b); }
            toggle-autoplay => { root.appearance("autoplay"); }
            close => { root.queue-open = false; }
        }
    }
    }
}
